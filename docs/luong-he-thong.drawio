                <mxCell id="tong-quan-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;api.py&lt;/b&gt; — Dispatcher, LotView, DecisionView&lt;br&gt;(bản sao chỉ đọc; điểm CAO chạy TRƯỚC)" vertex="1">
