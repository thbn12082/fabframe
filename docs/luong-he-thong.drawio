                <mxCell id="tong-quan-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;Nguồn dispatcher&lt;/b&gt;&lt;br&gt;• dispatchers/: &lt;b&gt;8 luật Paper 4&lt;/b&gt; — FIFO, CR, ATC, SRPT,&lt;br&gt;&amp;nbsp;&amp;nbsp;ATC-CQT, SRPT-CQT, CQT-savable-first, Uniform&lt;br&gt;• my_dispatchers/: nhóm &lt;b&gt;Của tôi&lt;/b&gt;&lt;br&gt;• examples/priority_minus_cr.py (mẫu)" vertex="1">
